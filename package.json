{
  "name": "native-template",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev": "expo start --dev-client",
    "lint": "expo lint",
    "build:dev": "eas build --profile development --platform all",
    "build:preview": "eas build --profile preview --platform all",
    "build:prod": "eas build --profile production --platform all",
    "submit:android": "eas submit -p android --latest",
    "submit:ios": "eas submit -p ios --latest",
    "ci:fix": "bun run ci:check:fix && bun run ci:format:fix && bun run ci:lint:fix",
    "ci:check:fix": "biome check --fix",
    "ci:format": "biome format",
    "ci:format:fix": "biome format --fix",
    "ci:check": "biome check",
    "ci:lint": "biome lint",
    "ci:lint:fix": "biome lint --fix",
    "doctor": "bunx expo-doctor",
    "dep:update": "bunx expo install --check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "expo": "~57.0.10",
    "expo-build-properties": "~57.0.8",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.10",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.10",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.12",
    "expo-web-browser": "~57.0.2",
    "i18next": "^25.6.0",
    "lucide-react-native": "^0.556.0",
    "moti": "^0.30.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.68.0",
    "react-i18next": "^16.2.2",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-keychain": "^10.0.0",
    "react-native-mmkv": "^4.0.0",
    "react-native-nitro-modules": "^0.31.2",
    "react-native-raw-bottom-sheet": "^3.0.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.17",
    "tailwindcss-animate": "^1.0.7",
    "toastify-react-native": "^7.2.3",
    "uniwind": "^1.8.4",
    "zod": "^4.1.13"
