  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "eslintConfig": {
    "extends": "universe/native",
    "root": true
  },
  "private": true
}
